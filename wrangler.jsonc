{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geupddong-web-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "geupddong-web-preview" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "geupddong-next-preview-cache" }],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "workers_dev": true,
  "routes": [{ "pattern": "preview.geupddong.com", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": { "CACHE_RUNTIME": "workers", "SITE_INDEXABLE": "false" },
  "d1_databases": [{ "binding": "NEXT_TAG_CACHE_D1", "database_name": "geupddong-next-preview-tags", "database_id": "bbf77cf5-62e9-4c94-a8ec-a45c0e26deed" }]
}
