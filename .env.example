NEXT_PUBLIC_API_BASE_URL=https://api.geupddong.com
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
# Preview stays noindex. Enable only on the production Worker.
SITE_INDEXABLE=false
# Server-only. Use a dedicated random secret (32+ UTF-8 bytes), never an OAuth/JWT key.
CACHE_REVALIDATION_SECRET=
# Workers sets this in wrangler vars; leave node for local production smoke.
CACHE_RUNTIME=node
